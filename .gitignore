# Cache
.cache/

# Evaluation tooling (local dev-only)
dev_tools/evaluation/

# Local OpenMetadata evaluation environment (Docker volume + rendered configs
# with secrets); local scratch state, never commit.
openmetadata-eval/

# Claude Code's local agent-memory/session state — machine-specific, never commit.
.claude/projects/
dev_tools/pgadmin/

# Generated SQLite fixture DBs — built from the vendored .sql by
# dev_tools.fixtures.build_sqlite_fixtures; text is the source of truth, not the blob.
dev_tools/fixtures/sql/*.sqlite

# Local minikube deploy helper. Machine-specific by nature — it names one
# checkout's paths and reads API keys from the environment — so it stays out of
# the repo rather than shipping one developer's setup to everyone.
helm.sh

