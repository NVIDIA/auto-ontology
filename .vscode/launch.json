{
  "version": "0.2.0",
  "configurations": [

    // ── dor_prod ──────────────────────────────────────────────────────────
    {
      "name": "dor_prod: Ingest",
      "type": "debugpy",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "module": "dev_tools.local_ingest",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "dor_prod: Semantic compile",
      "type": "debugpy",
      "request": "launch",
      "module": "gsf.semantic",
      "args": ["--database-name", "dor_prod"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "dor_prod: Eval",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": ["--database-name", "dor_prod"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "dor_prod: Eval (single query)",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": ["--single", "--database-name", "dor_prod"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "dor_prod: Eval (consistency)",
      "type": "debugpy",
      "request": "launch",
      "module": "dev_tools.evaluation.eval_chatbot",
      "args": ["--consistency", "--runs", "10", "--database-name", "dor_prod"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": false
    },

