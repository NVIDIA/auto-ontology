NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# minimum 8 characters
NEO4J_PASSWORD=changeme123

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=gsf_dev
POSTGRES_DATABASE=gsf
# Optional overrides (defaults: localhost / 5432)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Remote source database that dev_tools/local_ingest.py reads from
# (schema + rows extracted into the local pgvector store).
CONNECTION_STRINGS=postgresql://user:password@host:5432/dbname
# Snowflake (required: user, password, account, warehouse, database in URL):
# CONNECTION_STRINGS=snowflake://user:pass@account?warehouse=COMPUTE_WH&database=MY_SF_DB

# Consumed by Prisma CLI (migrate, db push). Keep in sync with POSTGRES_* above.
DATABASE_URL=postgresql://gsf:gsf_dev@localhost:5432/gsf

PGADMIN_EMAIL=admin@nvidia.com
PGADMIN_PASSWORD=gsf_dev

# NVIDIA NIM credentials for embeddings + chat
NVIDIA_API_KEY=nvapi-...
BASE_URL=https://integrate.api.nvidia.com/v1
MODEL_NAME=nvidia/nemotron-3-nano-30b-a3b

# Embedding endpoint + model. MUST be identical for ingest and query,
# otherwise stored vectors and query vectors live in different spaces.
EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2

# Ingestion sweep cadence in hours (default 24). The ingestion service runs
# one ingest at startup, then every INGEST_INTERVAL_HOURS thereafter.
# INGEST_INTERVAL_HOURS=24

# Base URL of the ingestion service API used by the server to trigger ingest.
# Local: http://localhost:3002  |  Docker compose: http://ingestion-service:3002
INGESTION_SERVICE_URL=http://localhost:3002

# HashiCorp Vault (optional): when all four required vars below are set,
# connection credentials are stored in Vault instead of on the Neo4j node.
# Partial configuration is ignored and treated as unencrypted.
# VAULT_ADDR=https://vault.example.com
# VAULT_NAMESPACE=your-namespace
# VAULT_ROLE_ID=...
# VAULT_SECRET_ID=...
# Optional mount overrides (defaults shown):
# VAULT_AUTH_MOUNT=approle/nvdcs/dc1
# VAULT_KV_MOUNT=gsf

# Creatintals for the admin user of GSF
GSF_ADMIN_EMAIL=admin@nvidia.com
GSF_ADMIN_PASSWORD=gsfpassword123
AUTH_SECRET=myverylongsecret123
APP_URL=http://localhost:3000