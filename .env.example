# minimum 8 characters

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=auto_ontology

# Remote source database that dev-tools/ingest_local_postgres.py reads from
# (schema + rows extracted into the local pgvector store).
# CONNECTION_STRINGS=snowflake://user:password@account?warehouse=COMPUTE_WH&database=WIDEWORLDIMPORTERS
# CONNECTION_STRINGS=postgresql://user:password@host:5432/dbname
CONNECTION_STRINGS=postgresql://user:password@localhost:5432/wideworldimporters

PGADMIN_EMAIL=admin@nvidia.com
PGADMIN_PASSWORD=change-me

# Model-endpoint triplets. Every triplet has three fields:
#   <PREFIX>_ENDPOINT (URL) / <PREFIX>_API_KEY / <PREFIX>_MODEL
# Any field left unset falls back to the matching DEFAULT_MODELS_ value below, so a
# single DEFAULT_MODELS_ triplet can supply the shared endpoint/key/model for all of
# them. Only set the per-triplet fields that need to differ from the default.

# Default triplet — the fallback for every field of every triplet below.
DEFAULT_MODELS_API_KEY=your-api-key-here
DEFAULT_MODELS_ENDPOINT=https://inference-api.nvidia.com/v1
DEFAULT_MODELS_MODEL=aws/anthropic/bedrock-claude-opus-4-8

# Main (reasoning) model.
REASONING_API_KEY=your-api-key-here
REASONING_ENDPOINT=https://inference-api.nvidia.com/v1
REASONING_MODEL=aws/anthropic/bedrock-claude-opus-4-8

# Non-reasoning model, e.g. for entity extraction. Can point at a different
# endpoint than the main model.
NON_REASONING_API_KEY=your-api-key-here
NON_REASONING_ENDPOINT=https://inference-api.nvidia.com/v1
NON_REASONING_MODEL=azure/openai/gpt-4.1-mini

# Reranking triplet (used by the rerank flow's rerank_sql_results node).
RERANK_ENDPOINT=https://inference-api.nvidia.com/v1/rerank
RERANK_MODEL=nvidia/nvidia/llama-3.2-nv-rerankqa-1b-v2
RERANK_API_KEY=your-api-key-here

APP_URL=http://localhost:3000

# Public origin of the MCP server. Better Auth binds access tokens to
# ${AUTO_ONTOLOGY_MCP_PUBLIC_URL}/mcp, which must exactly match the URL clients connect to.
AUTO_ONTOLOGY_MCP_PUBLIC_URL=http://localhost:3003

# Ingestion sweep cadence in hours (default 24). The ingestion service runs
# one ingest at startup, then every INGEST_INTERVAL_HOURS thereafter.
# INGEST_INTERVAL_HOURS=24

# Base URL of the ingestion service API used by the server to trigger ingest.
# Local: http://localhost:3002  |  Docker compose: http://ingestion-service:3002
INGESTION_SERVICE_URL=http://localhost:3002

# HashiCorp Vault (optional): when all four required vars below are set,
# connection credentials are stored in Vault instead of on the catalog row.
# Partial configuration is ignored and treated as unencrypted.
# VAULT_ADDR=https://vault.example.com
# VAULT_NAMESPACE=your-namespace
# VAULT_ROLE_ID=...
# VAULT_SECRET_ID=...
# Optional mount overrides (defaults shown):
# VAULT_AUTH_MOUNT=approle/nvdcs/dc1
# VAULT_KV_MOUNT=auto-ontology

# Credentials for the admin user of Auto Ontology
AUTO_ONTOLOGY_ADMIN_EMAIL=admin@nvidia.com
AUTO_ONTOLOGY_ADMIN_PASSWORD=autoontologypassword123
AUTH_SECRET=myverylongsecret123

# --- Interactive clarification flow (master switch) ---
# Enables the interactive/clarification pipeline's opt-in behaviors by
# default: ASK_OUTPUT_TYPE, INJECT_CONDITIONAL_OUTPUT_HINT, and
# CLARIFY_MAX_DISTANCE below. Individual features can still be forced
# on/off explicitly via their own env var regardless of this setting.
# INTERACTIVE=false

# --- Output-type clarification question ---
# When enabled, a pure-regex check runs at session start to detect whether the
# question obviously expects a scalar or table result:
#   - Obvious scalar/table → skip the question, optionally set a SQL-gen hint
#   - Ambiguous            → ask "What type of output are you looking for?" before
#                            any other clarification question (costs one turn)
# Defaults to enabled when INTERACTIVE=true.
# Set ASK_OUTPUT_TYPE=false/true to disable/enable explicitly regardless of INTERACTIVE.
# ASK_OUTPUT_TYPE=true

# --- Conditional-output hint injection ---
# Injects a targeted CASE/WHEN hint when a question signals conditional or
# labeled output.
# Defaults to enabled when INTERACTIVE=true.
# Set INJECT_CONDITIONAL_OUTPUT_HINT=false/true to disable/enable explicitly regardless of INTERACTIVE.
# INJECT_CONDITIONAL_OUTPUT_HINT=true

# --- Entity-resolution VDB distance threshold (clarification flow) ---
# Explicit float override for CLARIFY_MAX_DISTANCE (entity_resolution.py).
# If unset: INTERACTIVE=true uses 0.65 (tuned for clarification), otherwise
# falls back to the general DEFAULT_MAX_DISTANCE (0.75).
# CLARIFY_MAX_DISTANCE=0.65

# --- Live DB probing (db_probe/config.py) ---
# All three checks are off by default, trading some always-on query cost for
# catching hallucinated/incorrect SQL that would otherwise silently return
# wrong (rather than erroring) results.
#
# Proactive pre-execution literal check: runs a few cheap DISTINCT probes on
# every query with a categorical filter, to catch wrong literals.
# DB_PROBE_PROACTIVE=false
#
# Pre-execution JSONB key-path check: a few cheap jsonb_object_keys probes on
# every query navigating JSONB via ->/->>, to catch a hallucinated key.
# Postgres-only regardless of this flag.
# DB_PROBE_JSONB_PATH_CHECK=false
#
# Pre-execution join-path check: cheap Neo4j existence checks against the
# SEMANTIC_FK graph (falling back to a live value-overlap probe only when the
# graph has no edge for a predicate), to catch a hallucinated join between two
# plausible-looking identifier columns.
# DB_PROBE_JOIN_PATH_CHECK=false

# --- Vacuous GROUP BY check (sql_parse_validation.py) ---
# Rejects SQL that groups/partitions by a column already unique per row (e.g.
# GROUP BY the FROM table's own primary key), where any aggregate over it is
# a silent no-op. Off by default; set to true to enable it. The inference
# relies on PK/FK metadata and observed-data profiling, which can misfire on
# a dataset where that metadata is incomplete — a false positive rejects a
# correct query and burns a reconstruction cycle. Also used as a safety gate
# in join_path_check.py's self-applied bridge-fix path; disabling it there
# just means one fewer of the three checks guards that self-apply.
# DETECT_VACUOUS_GROUP_BY=true

# --- Intent-validation join wording (auto_ontology/retrieval/text_to_sql/agents/intent_validation.py) ---
# Defaults to DB_PROBE_JOIN_PATH_CHECK's value, so the two move together
# automatically — when that deterministic check is on, join legality is
# already covered, so this LLM check uses this branch's own, more permissive
# wording and skips AUTHORITATIVE JOIN PATHS; when it's off, this falls back
# to judging legality itself (matches main). Set explicitly to override.
# NOT RECOMMENDED: true here with DB_PROBE_JOIN_PATH_CHECK=false — nothing
# would then check join legality at all.
# INTENT_VALIDATION_JOINS_VALIDATED_ELSEWHERE=true

# --- Deterministic table-bridge reconciliation (candidates_preparation.py §5b) ---
# Between two tables the LLM relevance filter kept, force-restores a
# connecting bridge/junction table if the filter dropped it (the filter has
# repeatedly proven unreliable at preserving these even when shown the exact
# connection). The bridge table itself only needs to have been anywhere in
# the pre-filter candidate pool — semantic search, hub-sibling expansion,
# subject-term expansion, or extra retrieval, whichever surfaced it — not
# the same source as the two kept tables. Off by default; set to true to
# enable it and accept the extra Neo4j round trip per candidate pool.
# TABLE_BRIDGE_RECONCILIATION_ENABLED=true

# --- Table-relevance filter column context (candidates_preparation.py) ---
# Shows each candidate table's columns (name, type, description) to the LLM
# table-relevance filter, instead of just the table name + description. JSONB
# columns additionally get their key names and example values, since bare key
# names alone (e.g. "Res_Scr") can decoy-match an unrelated table. A/B tested
# against real gold-SQL ground truth: fixes real wrong table drops, but adds
# ~2s latency per relevance-filter call (heavier prompt). Off by default; set
# to true to enable.
# RELEVANCE_FILTER_INCLUDE_COLUMNS=true

# --- Hub-sibling expansion (candidates_preparation.py) ---
# Pulls in tables that share a hub with the anchor's own table via FK, so a
# structurally-relevant table with a weak/quiet description doesn't get
# dropped before the LLM relevance filter ever sees it. Off by default; set
# to true to enable it and accept the extra Neo4j + embedding-search cost.
# HUB_SIBLING_EXPANSION_ENABLED=true
# Siblings kept per hub after ranking by embedding similarity to the
# question's entities. Defaults to 6.
# HUB_SIBLING_CAP=6

# --- LLM invocation tuning (auto_ontology/utils/llm_invoke.py) ---
# Per-call timeout, in seconds.
# LLM_INVOKE_TIMEOUT_S=120
# Max concurrent LLM requests across all worker threads, to stay under the
# hosted endpoint's per-worker request cap (exceeding it surfaces as HTTP 503).
# LLM_MAX_INFLIGHT=6

# --- Entity extraction tuning ---
# Max entities the LLM is asked to extract per question, for SQL generation
# (text_to_sql/prompts.py). Defaults to 5.
# SQL_GEN_MAX_ENTITIES=5
# Max entities the LLM is asked to extract per question, for the clarification
# flow's entity_coverage pipeline (entity_coverage/prompts.py). Defaults to
# SQL_GEN_MAX_ENTITIES if unset.
# CLARIFICATION_MAX_ENTITIES=10

# --- KumoRFM predictive-query integration (optional) ---
# Setting KUMO_RFM_API_KEY is what turns the classify → prepare-graph →
# predict branch on in the SQL-gen graph at all (evaluated once at startup);
# leave unset to disable KumoRFM entirely.
# KUMO_RFM_API_URL=https://your-kumo-rfm-endpoint
# KUMO_RFM_API_KEY=your-kumo-api-key
# Bounds so building the graph on a large database stays tractable — the
# whole (capped) dataset is uploaded to the hosted KumoRFM service.
# KUMO_MAX_TABLES=20
# KUMO_MAX_ROWS_PER_TABLE=            # unset = unlimited
# KUMO_MAX_PREVIEW_ROWS=50
# KUMO_MAX_ENTITIES=2000
# KUMO_MAX_PQL_EXAMPLES=5

# --- Ingestion service (auto_ontology/ingestion_service) ---
# Port the standalone ingestion service listens on (see also
# INGESTION_SERVICE_URL above, which is the base URL the main app uses to
# reach it — differs between local and Docker).
# INGESTION_PORT=3002

# --- Misc ---
# Override the datasets root used to resolve enrichment metadata files
# (defaults to ./datasets relative to the working directory).
# DATASETS_DIR=./datasets
# Overrides the app version shown in logs/UX (defaults to the installed
# package version).
# APP_VERSION=
