// `frontend` only, and deliberately: `db push` reconciles every schema listed
// here against this file, so naming `public` would hand Prisma authority over
// GSF's own tables — it proposed dropping `alembic_version` the moment it was
// added. GSF's schema is Alembic's (see `gsf/dal/schema.py`), and the two stay
// out of each other's way by each listing only what it owns.
datasource db {
  provider = "postgresql"
  schemas  = ["frontend"]
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model Conversation {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @map("user_id")
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String    @default("")
  created_at DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updated_at DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  messages   Message[]

  @@index([user_id])
  @@map("conversations")
  @@schema("frontend")
}

model Message {
  id              String       @id @default(uuid()) @db.Uuid
  conversation_id String       @map("conversation_id") @db.Uuid
  role            String
  content         String       @default("")
  sql_code        String?      @map("sql_code")
  sql_response    String?      @map("sql_response")
  created_at      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("messages")
  @@schema("frontend")
}

model Prompt {
  id      String @id @default(uuid()) @db.Uuid
  content String @default("")

  @@map("prompts")
  @@schema("frontend")
}

// Generic key/value application settings (e.g. feature flags). Read by the
// Python ingestion service via psycopg to gate background jobs.
//
// Known keys:
//   semantic_compilation_enabled — "true"/"false", Settings > Semantic Compilation
//   visualization_enabled        — "true"/"false", Settings > Agent Settings
//                                  (auto-generate visualizations for SQL results;
//                                   a missing row means enabled)
model Configuration {
  key        String   @id
  value      String
  updated_at DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("configurations")
  @@schema("frontend")
}

model Acronym {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String   @default("")
  created_at  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updated_at  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("acronyms")
  @@schema("frontend")
}

model ConversationAnalytics {
  id                 String    @id @default(uuid()) @db.Uuid
  user_id            String    @map("user_id")
  user               User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source             String    @default("app") @map("source")
  question           String    @default("")
  question_timestamp DateTime  @default(now()) @map("question_timestamp") @db.Timestamptz
  response           String?
  response_timestamp DateTime? @map("response_timestamp") @db.Timestamptz
  sql                String?

  @@index([user_id])
  @@map("conversation_analytics")
  @@schema("frontend")
}

// Auto generated from https://better-auth.com/docs/concepts/database#generating-schema
model User {
  id                 String                  @id
  name               String
  email              String
  emailVerified      Boolean                 @default(false)
  image              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  role               String?
  banned             Boolean?                @default(false)
  banReason          String?
  banExpires         DateTime?
  sessions           Session[]
  accounts           Account[]
  ssoproviders       SsoProvider[]
  conversations      Conversation[]
  analytics          ConversationAnalytics[]
  apiKeys            Apikey[]
  oauthClients       OauthClient[]
  oauthTokens        OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthConsents      OauthConsent[]

  @@unique([email])
  @@map("user")
  @@schema("frontend")
}

model Session {
  id                 String              @id
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String?
  userAgent          String?
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy     String?
  oauthAccessTokens  OauthAccessToken[]
  oauthRefreshTokens OauthRefreshToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("frontend")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("frontend")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("frontend")
}

model SsoProvider {
  id             String  @id
  issuer         String
  oidcConfig     String?
  samlConfig     String?
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId     String
  organizationId String?
  domain         String

  @@unique([providerId])
  @@map("ssoProvider")
  @@schema("frontend")
}

// API tokens for machine-to-machine access (scripts, CI, notebooks). Owned and
// managed by the Better Auth `apiKey` plugin — field names/types must match the
// plugin's schema exactly, so this model breaks the snake_case convention the
// GSF-owned tables use, like the other Better Auth tables above.
//
// `key` holds a SHA-256 hash of the token, never the token itself: the plaintext
// is returned once at creation and is unrecoverable afterwards. `referenceId` is
// the owning user's id (the plugin is configured with references: "user"); the
// relation is declared here so revoking a user cascades to their tokens.
//
// The model is `Apikey`, not the more natural `ApiKey`, because the Better Auth
// Prisma adapter looks the model up as `prisma[<its model name>]` and the plugin
// names it `apikey` (all lowercase). Prisma derives the delegate from the model
// name, so `ApiKey` would generate `prisma.apiKey` and every call would fail at
// runtime with "Model apikey does not exist in the database".
model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean   @default(true)
  rateLimitEnabled    Boolean   @default(true)
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int       @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?

  @@index([configId])
  @@index([referenceId])
  @@index([key])
  @@map("apikey")
  @@schema("frontend")
}

// OAuth tables owned by Better Auth 1.7's `mcp` plugin (via
// `@better-auth/oauth-provider`). Field names and types must match the plugin
// schema exactly, like the other Better Auth tables above.
//
// The models are `Oauth*`, not `OAuth*`, for the same reason `Apikey` is not
// `ApiKey`: the adapter looks a model up as `prisma[<plugin's model name>]`, and
// the plugin names these `oauthClient`, `oauthAccessToken`, `oauthConsent`,
// etc. Prisma derives the delegate from the model name, so `OAuthClient` would
// generate `prisma.oAuthClient` and every call would fail at runtime.
//
// A client that registers itself has no owning user, so `userId` is optional —
// a dynamically registered MCP client belongs to no one until someone consents.
//
// These sit in `frontend` with the rest of Better Auth. `public` is Alembic's
// (see `gsf/dal/schema.py`); listing it on the datasource would let Prisma
// propose dropping GSF tables.
model OauthClient {
  id                               String    @id
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]  @default([])
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  user                             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime? @default(now())
  updatedAt                        DateTime? @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]  @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]  @default([])
  postLogoutRedirectUris           String[]  @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]  @default([])
  responseTypes                    String[]  @default([])
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  accessTokens  OauthAccessToken[]
  refreshTokens OauthRefreshToken[]
  consents      OauthConsent[]
  resources     OauthClientResource[]

  @@index([userId])
  @@map("oauthClient")
  @@schema("frontend")
}

model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  // Nullable JSON array, not `String[]`. Prisma cannot model optional lists,
  // and Better Auth seeds this as SQL NULL ("inherit plugin scopes"). An empty
  // array would intersect to no scopes and block every grant.
  allowedScopes                 Json?
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @default(now())
  updatedAt                     DateTime? @updatedAt
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clients OauthClientResource[]

  @@map("oauthResource")
  @@schema("frontend")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @default(now())

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
  @@schema("frontend")
}

model OauthRefreshToken {
  id                      String      @id
  token                   String      @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  expiresAt               DateTime
  createdAt               DateTime    @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]    @default([])

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
  @@schema("frontend")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  refreshId               String?
  refreshToken            OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: SetNull)
  expiresAt               DateTime
  createdAt               DateTime           @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]           @default([])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
  @@schema("frontend")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  scopes                  String[]    @default([])
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
  @@schema("frontend")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
  @@schema("frontend")
}
