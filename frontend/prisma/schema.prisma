datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  title     String    @default("")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  messages  Message[]

  @@map("conversations")
  @@schema("public")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           String
  content        String       @default("")
  sqlCode        String?      @map("sql_code")
  sqlResponse    String?      @map("sql_response")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
  @@schema("public")
}

model Prompt {
  id      String @id @default(uuid()) @db.Uuid
  content String @default("")

  @@map("prompts")
  @@schema("public")
}

model Acronym {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("acronyms")
  @@schema("public")
}

model ConversationAnalytics {
  id                String    @id @default(uuid()) @db.Uuid
  questionMessageId String    @unique @map("question_message_id") @db.Uuid
  question          String    @default("")
  questionTimestamp DateTime  @default(now()) @map("question_timestamp") @db.Timestamptz
  response          String?
  responseMessageId String?   @map("response_message_id") @db.Uuid
  responseTimestamp DateTime? @map("response_timestamp") @db.Timestamptz
  sql               String?

  @@map("conversation_analytics")
  @@schema("public")
}
